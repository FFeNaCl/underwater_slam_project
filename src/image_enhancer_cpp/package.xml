<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>image_enhancer_cpp</name>
  <version>0.0.0</version>
  <description>Underwater image enhancement for ROS2: red-channel compensation, Gray World white balance, CLAHE contrast enhancement and optional undistortion. Subscribes /image_raw and publishes /image_enhanced.</description>
  <maintainer email="15094819150@163.com">hu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>OpenCV</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
