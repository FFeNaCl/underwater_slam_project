# RViz2 配置：单目 SLAM 水下建图结果
#
# 用法:
#   rviz2 -d $(ros2 pkg prefix underwater_perception)/share/underwater_perception/config/rviz/slam.rviz
#
# 显示内容:
#   /slam/path          相机轨迹（Twc）
#   /slam/map_points    稀疏地图点
#   /semantic/markers   语义地标（绿=triangulated，黄=scale_fallback）
#   /yolo/annotated     YOLO 检测标注图
#   TF                  map -> camera
#
# Fixed Frame 必须是 map；若看不到点云，先 ros2 topic hz /slam/map_points。

Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TF1
        - /CameraPath1
        - /MapPoints1
        - /SemanticLandmarks1
        - /CameraImage1
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Alpha: 0.3
      Cell Size: 1
      Color: 120; 120; 120
      Line Style: Lines
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: CameraPath
      Alpha: 1
      Color: 30; 220; 120
      Line Style: Lines
      Line Width: 0.02
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam/path
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: MapPoints
      Alpha: 1
      Color Transformer: FlatColor
      Color: 200; 200; 200
      Size (Pixels): 4
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam/map_points
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: SemanticLandmarks
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /semantic/markers
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: CameraImage
      Max Value: 1
      Min Value: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /image_enhanced
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: YOLOAnnotated
      Max Value: 1
      Min Value: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /yolo/annotated
      Value: false
  Enabled: true
  Global Options:
    Background Color: 32; 36; 42
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Select
  Value: true
Window Geometry:
  Height: 900
  Width: 1600
  Displays:
    collapsed: false
  Views:
    collapsed: false
